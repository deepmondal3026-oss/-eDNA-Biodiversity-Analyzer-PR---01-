{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated researcher or administrator profile stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "organization": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "country": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "researchInterests": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin", "super_admin"]
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "email", "role", "accountStatus", "createdAt", "updatedAt"]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Trusted administrator privilege registry managed by super administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "super_admin"]
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "grantedBy", "grantedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Environmental DNA biodiversity research project metadata.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "biome": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["projectId", "ownerUid", "projectName", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-scoped application notification.",
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "enum": ["info", "analysis", "system", "security"]
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["notificationId", "uid", "title", "message", "category", "read", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable user activity metadata record.",
      "type": "object",
      "properties": {
        "activityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "details": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["activityId", "uid", "action", "timestamp"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global platform configuration editable only by administrators.",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "maxUploadSizeMb": {
          "type": "number"
        },
        "allowedExtensions": {
          "type": "array"
        },
        "defaultReferenceDb": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "maintenanceMode": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["settingId", "maxUploadSizeMb", "allowedExtensions", "defaultReferenceDb", "maintenanceMode", "updatedAt", "updatedBy"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles with role and account status isolation."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Admin privilege lookup documents."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User-owned eDNA biodiversity research projects."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped notifications."
    },
    "/activity_logs/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable user activity logs."
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Application-wide configuration controlled by admins."
    }
  }
}
